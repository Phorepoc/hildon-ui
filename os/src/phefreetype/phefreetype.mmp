// phefreetype.mmp -- OURS: FreeType 2.13.3 (FTL) as its own replaceable DLL, app-private under a new name. Code = prebuilt archive libphefreetype.a
// (recipes/build_freetype_x32.sh + package_x32.sh); exports = phefreetype.def (gen_defs.py).
TARGET			phefreetype.dll
TARGETTYPE		dll
UID				0x1000008d 0xE7015779
CAPABILITY		None
VENDORID		0
EPOCALLOWDLLDATA
EPOCHEAPSIZE	0x100000 0x4000000
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			phefreetype_dll.c
LIBRARY			euser.lib libc.lib libm.lib
SMPSAFE
