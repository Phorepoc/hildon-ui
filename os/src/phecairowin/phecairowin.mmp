// phecairowin.mmp -- OURS: the first Hildon-stack picture on screen: cairo (phecairo.dll) draws into a CFbsBitmap's memory, the bitmap is blitted
// into a full-screen WSERV window. A neutral demo (gradient, shapes, text in a ROM font through FreeType), NOT a theme.
TARGET			phecairowin.exe
TARGETTYPE		exe
UID				0x1000007a 0xE701577A
CAPABILITY		all -tcb
VENDORID		0
EPOCSTACKSIZE	0x20000
EPOCHEAPSIZE	0x100000 0x4000000
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			phecairowin.cpp
LIBRARY			euser.lib ws32.lib gdi.lib fbscli.lib libc.lib libm.lib libpthread.lib phecairo.lib phepixman.lib phefreetype.lib
SMPSAFE
