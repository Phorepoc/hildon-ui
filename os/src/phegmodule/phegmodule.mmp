// phegmodule.mmp -- OURS: the x32 GLib 2.56.4 (LGPL 2.1+) library "phegmodule" as its OWN replaceable DLL, app-private under a new name so the
// ROM's old ossrv glib is never touched. Code = prebuilt archive (hildon-symbian/recipes), exports = phegmodule.def (gen_defs.py).
TARGET			phegmodule.dll
TARGETTYPE		dll
UID				0x1000008d 0xE7015774
CAPABILITY		None
VENDORID		0
EPOCALLOWDLLDATA
EPOCHEAPSIZE	0x100000 0x4000000
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			phegmodule_dll.c
LIBRARY			euser.lib libc.lib libdl.lib pheglib.lib
SMPSAFE
