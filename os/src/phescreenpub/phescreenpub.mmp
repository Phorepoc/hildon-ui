//
// phescreenpub.mmp -- publish a WSERV screen as a window of the registry (multi-window stage 2, see phescreenpub.cpp)
TARGET			phescreenpub.exe
TARGETTYPE		exe
UID				0x1000007a 0xE701573B
// WriteDeviceData: RWsSession::SetFocusScreen; SwEvent: RWsSession::SimulateRawEvent (a frame's click into the app)
// PowerMgmt: a closed app that does not end within its grace time is killed (RProcess::Kill of another process)
CAPABILITY		WriteDeviceData SwEvent PowerMgmt
VENDORID		0
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
MW_LAYER_SYSTEMINCLUDE_SYMBIAN
USERINCLUDE		. ../../../../core/os/inc/phorepoc
SOURCEPATH		.
SOURCE			phescreenpub.cpp
LIBRARY			euser.lib hal.lib fbscli.lib ws32.lib apgrfx.lib aknicon.lib
SMPSAFE
