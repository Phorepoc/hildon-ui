// phepango.mmp -- OURS: Pango 1.40.14 (LGPL 2.1+): pango, pangoft2, pangocairo as its own replaceable DLL, app-private under a new name. Code = prebuilt archive (recipes/*.sh + package_x32.sh); exports = phepango.def (gen_defs.py).
TARGET			phepango.dll
TARGETTYPE		dll
UID				0x1000008d 0xE701577E
CAPABILITY		None
VENDORID		0
EPOCALLOWDLLDATA
EPOCHEAPSIZE	0x100000 0x4000000
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			phepango_dll.c
LIBRARY			euser.lib libc.lib libm.lib libpthread.lib pheglib.lib phegobject.lib phegmodule.lib phegthread.lib phecairo.lib phefreetype.lib phefontconfig.lib phehb.lib
SMPSAFE
