// phefontconfig.mmp -- OURS: fontconfig 2.14.2 + expat 2.5.0 (MIT) as its own replaceable DLL, app-private under a new name. Code = prebuilt archive (recipes/*.sh + package_x32.sh); exports = phefontconfig.def (gen_defs.py).
TARGET			phefontconfig.dll
TARGETTYPE		dll
UID				0x1000008d 0xE701577D
CAPABILITY		None
VENDORID		0
EPOCALLOWDLLDATA
EPOCHEAPSIZE	0x100000 0x4000000
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			phefontconfig_dll.c
LIBRARY			euser.lib libc.lib libm.lib libpthread.lib phefreetype.lib
SMPSAFE
