# phehildon.rc -- the Phorepoc Hildon look: the Etesian design language (light pages, dark chrome, one accent, 44 px touch targets) as a GTK 2 resource file.
# Tokens: hybrid mode of the Etesian language (surface #FFFFFF, page #E0E1E2, text #282828, muted #505050, border #6A6A6A, accent #1C51AF, chrome #3A3A3A). No images: colours, spacing, fonts.
gtk-font-name = "Sans 12"
gtk-button-images = 0
gtk-menu-images = 0

style "ph-base"
{
  font_name = "Sans 12"
  xthickness = 2
  ythickness = 2
  bg[NORMAL]      = "#E0E1E2"
  bg[PRELIGHT]    = "#F2F3F4"
  bg[ACTIVE]      = "#C4C7CC"
  bg[SELECTED]    = "#1C51AF"
  bg[INSENSITIVE] = "#E0E1E2"
  fg[NORMAL]      = "#282828"
  fg[PRELIGHT]    = "#282828"
  fg[ACTIVE]      = "#282828"
  fg[SELECTED]    = "#FFFFFF"
  fg[INSENSITIVE] = "#6A6A6A"
  base[NORMAL]      = "#FFFFFF"
  base[PRELIGHT]    = "#FFFFFF"
  base[SELECTED]    = "#1C51AF"
  base[ACTIVE]      = "#1C51AF"
  base[INSENSITIVE] = "#F2F3F4"
  text[NORMAL]      = "#282828"
  text[SELECTED]    = "#FFFFFF"
  text[ACTIVE]      = "#FFFFFF"
  text[INSENSITIVE] = "#6A6A6A"
}
class "GtkWidget" style "ph-base"

style "ph-button" = "ph-base"
{
  xthickness = 10
  ythickness = 10
  bg[NORMAL]   = "#F2F3F4"
  bg[PRELIGHT] = "#FFFFFF"
  bg[ACTIVE]   = "#C4C7CC"
}
class "GtkButton" style "ph-button"
class "GtkToggleButton" style "ph-button"

style "ph-entry" = "ph-base"
{
  xthickness = 8
  ythickness = 10
}
class "GtkEntry" style "ph-entry"

style "ph-progress" = "ph-base"
{
  bg[PRELIGHT] = "#1C51AF"
  fg[PRELIGHT] = "#FFFFFF"
}
class "GtkProgressBar" style "ph-progress"

style "ph-menu" = "ph-base"
{
  bg[NORMAL]   = "#3A3A3A"
  bg[PRELIGHT] = "#1C51AF"
  fg[NORMAL]   = "#FFFFFF"
  fg[PRELIGHT] = "#FFFFFF"
  xthickness = 8
  ythickness = 10
}
class "GtkMenu" style "ph-menu"
class "GtkMenuItem" style "ph-menu"
