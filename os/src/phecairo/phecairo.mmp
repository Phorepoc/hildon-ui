// phecairo.mmp -- OURS: cairo 1.16.0 (LGPL 2.1 or MPL 1.1) as its own replaceable DLL, app-private under a new name. Code = prebuilt archive libphecairo.a
// (recipes/build_cairo_x32.sh + package_x32.sh); exports = phecairo.def (gen_defs.py).
TARGET			phecairo.dll
TARGETTYPE		dll
UID				0x1000008d 0xE7015778
CAPABILITY		None
VENDORID		0
EPOCALLOWDLLDATA
EPOCHEAPSIZE	0x100000 0x4000000
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			phecairo_dll.c
LIBRARY			euser.lib libc.lib libm.lib libpthread.lib phepixman.lib
SMPSAFE
