// phepixbuf.mmp -- OURS: gdk-pixbuf 2.36.12 (LGPL 2+) with the PNG loader built in as its own replaceable DLL, app-private under a new name. Code = prebuilt archive (recipes/*.sh + package_x32.sh); exports = phepixbuf.def (gen_defs.py).
TARGET			phepixbuf.dll
TARGETTYPE		dll
UID				0x1000008d 0xE701577F
CAPABILITY		None
VENDORID		0
EPOCALLOWDLLDATA
EPOCHEAPSIZE	0x100000 0x4000000
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			phepixbuf_dll.c
LIBRARY			euser.lib libc.lib libm.lib libpthread.lib pheglib.lib phegobject.lib phegmodule.lib phegthread.lib phegio.lib phepng.lib
SMPSAFE
