// phehome.mmp -- OURS: the Home process. C code (phehome_main.c + hildon-home's hd-applet-manager.c and hd-widgets.c) = prebuilt archive libphehome.a (recipes/build_hildonhome_x32.sh).
TARGET			phehome.exe
TARGETTYPE		exe
UID				0x1000007a 0xE7015791
CAPABILITY		all -tcb
VENDORID		0
EPOCSTACKSIZE	0x100000
EPOCHEAPSIZE	0x100000 0x4000000
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			phehome.cpp
START RESOURCE	phehome_loc.rss
HEADER
TARGETPATH		/resource/apps
END

START RESOURCE	phehome_reg.rss
TARGETPATH		/private/10003a3f/apps
END
USERINCLUDE		.
LIBRARY			euser.lib ws32.lib gdi.lib fbscli.lib libc.lib libm.lib libpthread.lib pheglib.lib phegobject.lib phegmodule.lib phegthread.lib phegio.lib phepng.lib phepixman.lib phefreetype.lib phefontconfig.lib phehb.lib phecairo.lib phepango.lib phepixbuf.lib phegdk.lib pheatk.lib phegtk.lib phehildon.lib phedbus.lib phedbusglib.lib phehildondesktop.lib
SMPSAFE
