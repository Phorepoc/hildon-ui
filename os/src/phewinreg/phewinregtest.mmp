// phewinregtest.mmp -- the window registry's self test (hildon-port.md C4)
TARGET			phewinregtest.exe
TARGETTYPE		exe
UID				0x1000007a 0xE7016B41
// PowerMgmt: the ping test suspends another process's thread (a hung app)
CAPABILITY		PowerMgmt
VENDORID		0
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
USERINCLUDE		.
SOURCEPATH		.
SOURCE			phewinregtest.cpp
LIBRARY			euser.lib fbscli.lib
SMPSAFE
