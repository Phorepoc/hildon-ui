TARGETTYPE		exe
UID				0x1000007a 0xE7016B40
CAPABILITY		none
VENDORID		0
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
MW_LAYER_SYSTEMINCLUDE_SYMBIAN
USERINCLUDE		. ../../../../core/os/inc/phorepoc
SOURCEPATH		.
SOURCE			phewinreg.cpp
LIBRARY			euser.lib hal.lib fbscli.lib apgrfx.lib apparc.lib efsrv.lib aknicon.lib
SMPSAFE
